# Example environment variables for the webhost.systems dashboard (Vite + React + Supabase)
# Copy this file to `.env.local` and replace placeholders with real values.
#
# IMPORTANT:
# - Keep real keys ONLY in `.env.local` (not committed).
# - Vite requires the `VITE_` prefix to expose env vars to client-side code.

# Supabase local dev (from `supabase start` output at repo root)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
